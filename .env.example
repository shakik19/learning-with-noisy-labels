# Environment template — copy to .env (git-ignored), fill in the <...> values, then load it in
# every new shell from the repo root:
#
#   set -a; source .env; set +a
#
# Terraform reads every TF_VAR_<name> automatically, so `terraform apply` needs no -var flags.
# Keep values quoted: an unquoted <...> placeholder is parsed by the shell as a redirection.

#  GCP location (Spot L4 capacity moves around: change REGION/ZONE, re-source, re-apply) 
PROJECT_ID="<PROJECT_ID>"
REGION="<REGION>"
ZONE="<ZONE>"

# VM
VM_NAME="nl-trainer"
MACHINE_TYPE="g2-standard-4"
IMAGE_FAMILY="pytorch-2-9-cu129-ubuntu-2204-nvidia-580"
DISK_SIZE_GB="100"                # minimum allowed by the Deep Learning VM image
SPOT="true"                       
# "false" = on-demand fallback

# Terraform service account + key (key stays outside the repo) 
TF_SA_NAME="tf-noisy-labels"
TF_SA="${TF_SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"
TF_CREDENTIALS_FILE="${HOME}/.config/gcloud/${TF_SA_NAME}.json"

# Sync (REMOTE_DIR is relative to the VM user's home directory) 
REMOTE_DIR="noisy-labels"
HOST="${VM_NAME}.${ZONE}.${PROJECT_ID}"   # alias written by `gcloud compute config-ssh`

# Terraform inputs (derived from the values above; no need to edit) 
TF_VAR_project_id="${PROJECT_ID}"
TF_VAR_region="${REGION}"
TF_VAR_zone="${ZONE}"
TF_VAR_instance_name="${VM_NAME}"
TF_VAR_machine_type="${MACHINE_TYPE}"
TF_VAR_image_family="${IMAGE_FAMILY}"
TF_VAR_disk_size_gb="${DISK_SIZE_GB}"
TF_VAR_spot="${SPOT}"
TF_VAR_credentials_file="${TF_CREDENTIALS_FILE}"
